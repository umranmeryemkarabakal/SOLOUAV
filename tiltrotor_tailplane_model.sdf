          <lower>0.</lower>
          <upper>0.349</upper>
          <!-- 90 -> 20 DERECE (2026-08-30, adim 133). Fiziksel kisit: 0.10 m
               yaricapli disk 90 derecede alt ucu z = motor_z - 0.10 = -0.055'e
               iniyor ve kuyruk cubugunun icinden geciyor. Motoru yukseltmek
               denendi (z 0.045 -> 0.135) ve GERI ALINDI: geri gecişte uc rotor
               da 45 N'e doydu, BIG_M 0 -> 3843 (tau_y = r_z*Fx - r_x*Fz, ve
               geri gecis tam olarak tilt'li rejimde yasiyor).
               20 derece OLCUME dayaniyor: tam gorevde kuyruk tilt'i en fazla
               2.5 derece kullanildi (ULog 05_47_06), yani sinir gercek
               kullanimin 8 kati. 20 derecede cubuga aciklik 24 mm. -->
        </limit>
        <dynamics>
          <friction>1.0</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>
