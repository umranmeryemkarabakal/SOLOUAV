        </material>
      </visual>
          <!-- COLLISION EKLENDI (2026-08-30, adim 133). Bu bes yuzeyin yalnizca
           gorseli vardi, yani Gazebo icin FIZIKSEL OLARAK YOKTULAR: yere
           degmiyor, hicbir seye carpmiyorlardi. Yan yatarak inen bir aracta
           once kanat ucu / elevon degir, govde levhasi degil.
           kp/kd govde kutusuyla ayni mertebede ama biraz yumusak: ince
           kompozit bir yuzey rijit bir kutu gibi davranmaz. -->
      <collision name='left_elevon_collision'>
        <pose>-0.105 0.004 -0.034 1.5707963268 0 3.1415926536</pose>
        <geometry>
          <box>
            <!-- DIKKAT (2026-08-31, adim 137): bu kutu MESH'in donmus pozunu
                 (rpy = pi/2, 0, pi) miras aliyor, yani YEREL eksenler dunya
                 eksenleriyle ayni DEGIL. Donus yerel y'yi dunya z'ye, yerel
                 z'yi dunya -y'ye tasiyor.
                 ILK YAZIMDA 0.09 0.34 0.012 verilmisti ve olculdugunde kutu
                 dunyada 0.090 x 0.012 x 0.340 cikti - yani 34 cm'lik boyut
                 DIKEY duruyordu: kanattan asagi sarkan bir levha. Elevon ince
                 bir yuzeydir, kalinligi 12 mm olmali.
                 Dogrusu: yerel (0.09, 0.012, 0.34) -> dunya (0.09, 0.34, 0.012). -->
            <size>0.09 0.012 0.34</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>50000</kp>
              <kd>2.0</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>0.6</mu>
              <mu2>0.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
</link>
