              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>0.6</mu>
              <mu2>0.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
</link>
    <!-- FIN ILE BIRLIKTE GERIYE ALINDI -0.83 -> -0.95 (2026-08-30, adim 132).
         Rudder fininin arkasina mentesli; fin tasinirsa o da tasinmali, yoksa
         mentese havada kalir. Rudder'in KENDISI kontrol yasasinda kalici olarak
         KAPALI (a_rud = 0, adim 77) — yani bu yalnizca geometrik tutarlilik
         icin, kontrol davranisini degistirmez. -->
    <link name="rudder">
      <pose>-0.87 0 0.10 0 0 0</pose>
      <inertial>
        <mass>0.00000001</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <ixy>0.0</ixy>
          <iyy>0.000001</iyy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
          <izz>0.000001</izz>
        </inertia>
      </inertial>
        <enable_wind>true</enable_wind>
      <visual name="rudder_visual">
        <geometry>
          <box>
            <size>0.05 0.01 0.18</size>
          </box>
        </geometry>
        <material>  <!-- Blue -->
          <ambient>0 0 1 1.0</ambient>
          <diffuse>0 0 1 1.0</diffuse>
        </material>
      </visual>
          <collision name='rudder_collision'>
        <geometry>
          <box>
            <size>0.05 0.01 0.18</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>50000</kp>
              <kd>2.0</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>0.6</mu>
              <mu2>0.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
</link>
    <joint name='left_elevator_joint' type='revolute'>
      <parent>base_link</parent>
      <child>left_elevator</child>
      <pose>0.025 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.52</lower>
          <upper>0.52</upper>
        </limit>
        <dynamics>
          <damping>1.000</damping>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
      <physics>
        <ode>
          <implicit_spring_damper>1</implicit_spring_damper>
        </ode>
      </physics>
    </joint>
    <joint name='right_elevator_joint' type='revolute'>
      <parent>base_link</parent>
      <child>right_elevator</child>
      <pose>0.025 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.52</lower>
          <upper>0.52</upper>
        </limit>
        <dynamics>
          <damping>1.000</damping>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
      <physics>
        <ode>
          <implicit_spring_damper>1</implicit_spring_damper>
        </ode>
      </physics>
    </joint>
    <joint name='rudder_joint' type='revolute'>
      <parent>base_link</parent>
      <child>rudder</child>
      <pose>0.025 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.52</lower>
          <upper>0.52</upper>
        </limit>
        <dynamics>
          <damping>1.000</damping>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
      <physics>
        <ode>
          <implicit_spring_damper>1</implicit_spring_damper>
        </ode>
      </physics>
    </joint>

    <!-- ===================== Aerodynamics =====================
         Wing coefficients are the tiltrotor models', unchanged. The tail surfaces are
         new: this airframe puts pitch and yaw on a real empennage in forward flight
         rather than on wing elevons alone. -->

    <!-- Wing halves. The x8 elevons act as ailerons here (roll only) - pitch is the
         tailplane's job - which is what CA_SV_CS0/1_TYPE 1/2 declare. -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.05984281113</a0>
      <cla>4.752798721</cla>
      <cda>0.6417112299</cda>
      <cma>0.0</cma>
      <alpha_stall>0.3391428111</alpha_stall>
      <cla_stall>-3.85</cla_stall>
      <cda_stall>-0.9233984055</cda_stall>
      <cma_stall>0</cma_stall>
      <cp>-0.05 0.3 0.05</cp>
      <area>0.5</area>
      <air_density>1.2041</air_density>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <link_name>base_link</link_name>
      <control_joint_name>
        left_elevon_joint
      </control_joint_name>
      <control_joint_rad_to_cl>-4.0</control_joint_rad_to_cl>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>left_elevon_joint</joint_name>
      <sub_topic>servo_0</sub_topic>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.05984281113</a0>
      <cla>4.752798721</cla>
      <cda>0.6417112299</cda>
      <cma>0.0</cma>
      <alpha_stall>0.3391428111</alpha_stall>
      <cla_stall>-3.85</cla_stall>
      <cda_stall>-0.9233984055</cda_stall>
      <cma_stall>0</cma_stall>
      <cp>-0.05 -0.3 0.05</cp>
      <area>0.5</area>
      <air_density>1.2041</air_density>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <link_name>base_link</link_name>
      <control_joint_name>
        right_elevon_joint
      </control_joint_name>
      <control_joint_rad_to_cl>-4.0</control_joint_rad_to_cl>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>right_elevon_joint</joint_name>
      <sub_topic>servo_1</sub_topic>
    </plugin>

    <!-- Horizontal stabiliser, one panel per side, each carrying its elevator.
         a0 = -0.2 gives the download a conventional tail needs to trim a nose-heavy
         aircraft, matching the 2+1 model's elevator. area 0.048 = 0.16 m chord *
         0.30 m semi-span. -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>-0.2</a0>
      <cla>4.752798721</cla>
      <cda>0.6417112299</cda>
      <cma>0.0</cma>
      <alpha_stall>0.3391428111</alpha_stall>
      <cla_stall>-3.85</cla_stall>
      <cda_stall>-0.9233984055</cda_stall>
      <cma_stall>0</cma_stall>
      <cp>-0.70 0.15 -0.04</cp>
      <area>0.048</area>
      <air_density>1.2041</air_density>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <link_name>base_link</link_name>
      <control_joint_name>
        left_elevator_joint
      </control_joint_name>
      <control_joint_rad_to_cl>-12.0</control_joint_rad_to_cl>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>left_elevator_joint</joint_name>
      <sub_topic>servo_2</sub_topic>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>-0.2</a0>
      <cla>4.752798721</cla>
      <cda>0.6417112299</cda>
      <cma>0.0</cma>
      <alpha_stall>0.3391428111</alpha_stall>
      <cla_stall>-3.85</cla_stall>
      <cda_stall>-0.9233984055</cda_stall>
      <cma_stall>0</cma_stall>
      <cp>-0.70 -0.15 -0.04</cp>
      <area>0.048</area>
      <air_density>1.2041</air_density>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <link_name>base_link</link_name>
      <control_joint_name>
        right_elevator_joint
      </control_joint_name>
      <control_joint_rad_to_cl>-12.0</control_joint_rad_to_cl>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>right_elevator_joint</joint_name>
      <sub_topic>servo_3</sub_topic>
    </plugin>

    <!-- Fin and rudder. upward = 0 1 0 turns this panel on its side, so its "lift" is
         a sideforce at x = -0.74 and yaws the aircraft. Unlike the 2+1 model's fin,
         which is a bare surface, this one is driven: control_joint_name makes the
         rudder a real actuator. area 0.032 = 0.16 m chord * 0.2 m height. -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.0</a0>
      <cla>4.752798721</cla>
      <cda>0.6417112299</cda>
      <cma>0.0</cma>
      <alpha_stall>0.3391428111</alpha_stall>
      <cla_stall>-3.85</cla_stall>
      <cda_stall>-0.9233984055</cda_stall>
      <cma_stall>0</cma_stall>
      <!-- cp fin ile birlikte -0.74 -> -0.86 (adim 132). Bu bir KONTROL
           SABITIDIR: TiltrotorIndiParams.hpp SURF_CPX[4] ile SENKRON KALMALI. -->
      <cp>-0.78 0 0.10</cp>
      <area>0.032</area>
      <air_density>1.2041</air_density>
      <forward>1 0 0</forward>
      <upward>0 1 0</upward>
      <link_name>base_link</link_name>
      <control_joint_name>
        rudder_joint
      </control_joint_name>
      <control_joint_rad_to_cl>-6.0</control_joint_rad_to_cl>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>rudder_joint</joint_name>
      <sub_topic>servo_4</sub_topic>
    </plugin>

    <!-- ===================== Propulsion ===================== -->
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1500</maxRotVelocity>
      <motorConstant>2e-05</motorConstant>
      <momentConstant>0.06</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>0.0000806428</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>motor_0_joint</joint_name>
      <sub_topic>servo_5</sub_topic>
      <p_gain>100</p_gain>
      <i_gain>0</i_gain>
      <d_gain>0</d_gain>
      <i_max>0.0</i_max>
      <i_min>0.0</i_min>
      <cmd_max>2</cmd_max>
      <cmd_min>-2</cmd_min>
      <err_max>0.2</err_max>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1500</maxRotVelocity>
      <motorConstant>2e-05</motorConstant>
      <momentConstant>0.06</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>0.0000806428</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>motor_1_joint</joint_name>
      <sub_topic>servo_6</sub_topic>
      <p_gain>100</p_gain>
      <i_gain>0</i_gain>
      <d_gain>0</d_gain>
      <i_max>0.0</i_max>
      <i_min>0.0</i_min>
      <cmd_max>2</cmd_max>
      <cmd_min>-2</cmd_min>
      <err_max>0.2</err_max>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1500</maxRotVelocity>
      <motorConstant>2e-05</motorConstant>
      <momentConstant>0.06</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>2</motorNumber>
      <rotorDragCoefficient>0.0000806428</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>motor_2_joint</joint_name>
      <sub_topic>servo_7</sub_topic>
      <p_gain>100</p_gain>
      <i_gain>0</i_gain>
      <d_gain>0</d_gain>
      <i_max>0.0</i_max>
      <i_min>0.0</i_min>
      <cmd_max>2</cmd_max>
      <cmd_min>-2</cmd_min>
      <err_max>0.2</err_max>
    </plugin>

    <!--
      GOZLEM AMACLI (2026-07-28, Adim 18) — fizigi/kontrolu ETKILEMEZ.
      Amac: mc_indi_tiltrotor'un ic `_u_actual` GOLGE aktuator modelini
      (MulticopterIndiTiltrotor.cpp:414-421, 1. derece gecikme + slew clamp,
      Gazebo'dan SIFIR geri besleme) tilt eklemlerinin GERCEK acisiyla
      karsilastirabilmek. Gercek servo yukaridaki JointPositionController'dir:
      P=100, I=D=0, cmd_max=2 (tork limiti), err_max=0.2 -> |hata| >= 0.02 rad
      icin sabit 2 Nm ile doyan, TORK-SINIRLI 2. DERECE bir sistem; golge model
      ise 1. derece. Sapmayi olcmek raporun §4 (Q) 1. onceligidir.
      Yayin: /world/<world>/model/<model>/joint_state  (gz.msgs.Model)

      ADIM 20 EKI (2026-07-28): rotor_{0,1,2}_joint de eklendi. Amac, GERCEK
      rotor itkisini eklem HIZINDAN turetmek: T = motorConstant * w^2, burada
      w = joint_velocity * rotorVelocitySlowdownSim (=20). Boylece golge
      modelin ITKI kanallari da (Adim 18'de yalnizca tilt'ler karsilastirilmisti)
      gercekle karsilastirilabilir. Bu onemli, cunku yaw torkunun bir bileseni
      rotor reaksiyon torkudur (km*T). Ayrica yapisal bir supheli var: gz'nin
      timeConstantUp/Down filtresi ROTOR HIZINA (w) uygulanirken, PX4'un golge
      modeli ayni zaman sabitini ITKIYE (T) uyguluyor; T = kf*w^2 oldugundan
      bunlar buyuk gecislerde ayrisir.
    -->
    <plugin filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <joint_name>motor_0_joint</joint_name>
      <joint_name>motor_1_joint</joint_name>
      <joint_name>motor_2_joint</joint_name>
      <joint_name>rotor_0_joint</joint_name>
      <joint_name>rotor_1_joint</joint_name>
      <joint_name>rotor_2_joint</joint_name>
    </plugin>
    <static>0</static>
  </model>
</sdf>
